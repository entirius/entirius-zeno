# dev-runner settings of the CMS hotfix agent: the main runner .env (models, efforts, CLI pin) plus its own state,
# limits and base. Sourced by scripts/dev-runner/lib.sh through ENV_FILE.
_Z=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
source "$_Z/scripts/dev-runner/.env"
STATE_DIR=$_Z/.runner/hotfix
STOP_FILE=$_Z/.runner/hotfix/STOP
BASE_BRANCH=origin/master
DAILY_CAP_USD=75
MAX_ATTEMPTS=2
# Own stream id: its push-guard marker in the CMS hooks dir (shared with the hotfix worktree) must not be mistaken for
# the main runner's stream 1 — a finished hotfix plan would otherwise remove the main runner's guard.
STREAM=9
WORK_DIR=$_Z/.runner/hotfix/work
LOCK_FILE=$_Z/.runner/hotfix/lock
# A hotfix plan writes only its worktree; every other clone belongs to the main runner loop or the operator, so none
# of them may park a hotfix. The zeno root stays watched (the runner cannot ignore it).
SCOPE_IGNORE=$(cd "$_Z" && for d in repos/*/*/; do d=${d%/}; [[ -e $d/.git && $d != repos/pwa/entirius-pwa-cms-hotfix ]] && printf '%s ' "$d"; done)
unset _Z
