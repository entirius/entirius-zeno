# dev-runner config (copy to scripts/dev-runner/.env — gitignored). Code defaults in lib.sh load_env.
BASE_BRANCH=develop
MAX_ATTEMPTS=3
MAX_REVIEW_ROUNDS=1
# per-role --max-budget-usd (the plan's BUDGET_USD caps the whole plan, DAILY_CAP_USD the day)
CODER_CAP_USD=15
REVIEWER_CAP_USD=3
TRIAGE_CAP_USD=1
DAILY_CAP_USD=60
ROLE_TIMEOUT=3600
SENTINEL_GRACE=90
# roles: coder = Opus, reviewer/triage = Fable 5 (empty = profile default)
CODER_MODEL=claude-opus-5
REVIEWER_MODEL=claude-fable-5
TRIAGE_MODEL=claude-fable-5
# `claude --version` must match or the runner refuses to start (empty = no check)
CLAUDE_CLI_PIN=2.1.241
# auth for the role profiles (~/.claude-runner/<role>): API key here, or `RUNNER_SHARE_LOGIN=1 make runner-init`
# to copy the operator's OAuth credentials file into each profile
#ANTHROPIC_API_KEY=
#RUNNER_SHARE_LOGIN=0
# gitleaks config used for every scan (never the reviewed repo's own); default: zeno's canonical symlink
#GITLEAKS_CONFIG=
