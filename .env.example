# entirius-zeno environment configuration
# Copy to .env: make init
#
# Read by BOTH make (as a makefile) and docker compose (as an env file), which parse
# differently — keep values plain: no $, no quotes, no spaces around =, no inline # comments.

COMPOSE_PROJECT_NAME=entirius-zeno

# Service under test
SERVICE=entirius-service-volkanos
SERVICE_BRANCH=develop
SERVICE_PORT=8100

# PostgreSQL
POSTGRES_DB=entirius
POSTGRES_USER=entirius
POSTGRES_PASSWORD=entirius-dev
POSTGRES_PORT=5532

# Redis
REDIS_PORT=6479

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5772
RABBITMQ_MANAGEMENT_PORT=15772

# Source paths (dev mode — local clones mounted into the container)
SERVICES_PATH=./repos/services
PY_PATH=./repos/py
DJANGO_PATH=./repos/django
TESTS_PATH=./repos/tests
DOCS_PATH=./repos/docs

# Frontends (profiles pwa / cms)
PWA_PORT=3100
CMS_PORT=8180
DASHBOARD_PORT=8200
DOCS_PORT=4421
# Second docs instance (make docs-alt DOCS_ALT_BRANCH=<branch>)
DOCS_ALT_PORT=4422
# Marketing site entirius.com (make www; branch via WWW_BRANCH)
WWW_PORT=3200
WWW_BRANCH=master
# Shared: the channel the storefront serves and the CMS edits
PWA_CHANNEL=default-europe

# Embedding service (make embed). GPU is auto-detected from /etc/cdi/nvidia.yaml; force with EMBED_GPU=0/1
EMBED_MODEL=google/siglip-so400m-patch14-384
EMBED_DIM=1152
EMBED_PORT=8097

# Mail sandbox (GreenMail, make mail)
GREENMAIL_SMTP_PORT=3125
GREENMAIL_IMAP_PORT=3243
GREENMAIL_API_PORT=8380

# AI toolbox (outside zeno; make toolbox-check). The key belongs in .env only — never here.
AI_TOOLBOX_BASE_URL=http://host.docker.internal:8300
AI_TOOLBOX_API_KEY=
AI_TOOLBOX_CHANNEL=zeno-test

# Access gate of the service (django_access): enforce | observe | off
ACCESS_GATE_MODE=enforce

# Outreach SMTP of channel default-europe — unset = the GreenMail sandbox (BDD baseline). Set to send the
# funnel through a real server; the channel stays in sandbox mode, so every mail lands in its sandbox mailbox.
# Verify with the CMS configuration panel → "Check again" (one SMTP login).
# OUTREACH_SMTP_HOST=smtp.example.com
# OUTREACH_SMTP_PORT=587
# OUTREACH_SMTP_USER=
# OUTREACH_SMTP_PASSWORD=
# OUTREACH_SMTP_USE_TLS=true
# OUTREACH_SMTP_USE_SSL=false
# OUTREACH_SMTP_FROM=
# Required with a real host — every recipient of every module's mail is rewritten to this one address
# (header X-Zeno-Original-To keeps the real ones); the service refuses to boot without it.
# ZENO_MAIL_REDIRECT_TO=
