# entirius-zeno environment configuration
# Copy to .env: make init

COMPOSE_PROJECT_NAME=entirius-zeno

# Service under test
SERVICE=entirius-service-volkanos
SERVICE_BRANCH=master
SERVICE_PORT=8100

# PostgreSQL
POSTGRES_DB=entirius
POSTGRES_USER=entirius
POSTGRES_PASSWORD=entirius-dev
POSTGRES_PORT=5532

# Redis
REDIS_PORT=6479

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5772
RABBITMQ_MANAGEMENT_PORT=15772

# Source paths (dev mode — local clones mounted into the container)
SERVICES_PATH=./repos/services
PY_PATH=./repos/py
DJANGO_PATH=./repos/django
TESTS_PATH=./repos/tests
