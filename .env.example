# entirius-zeno environment configuration
# Copy to .env: make init
#
# Read by BOTH make (as a makefile) and docker compose (as an env file), which parse
# differently — keep values plain: no $, no quotes, no spaces around =, no inline # comments.

COMPOSE_PROJECT_NAME=entirius-zeno

# Service under test
SERVICE=entirius-service-volkanos
SERVICE_BRANCH=develop
SERVICE_PORT=8100

# PostgreSQL
POSTGRES_DB=entirius
POSTGRES_USER=entirius
POSTGRES_PASSWORD=entirius-dev
POSTGRES_PORT=5532

# Redis
REDIS_PORT=6479

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5772
RABBITMQ_MANAGEMENT_PORT=15772

# Source paths (dev mode — local clones mounted into the container)
SERVICES_PATH=./repos/services
PY_PATH=./repos/py
DJANGO_PATH=./repos/django
TESTS_PATH=./repos/tests
DOCS_PATH=./repos/docs

# Frontends (profiles pwa / cms)
PWA_PORT=3100
CMS_PORT=8180
DASHBOARD_PORT=8200
DOCS_PORT=4421
# Second docs instance (make docs-alt DOCS_ALT_BRANCH=<branch>)
DOCS_ALT_PORT=4422
# Marketing site entirius.com (make www; branch via WWW_BRANCH)
WWW_PORT=3200
WWW_BRANCH=master
# Shared: the channel the storefront serves and the CMS edits
PWA_CHANNEL=default-europe

# Embedding service (make embed). GPU is auto-detected from /etc/cdi/nvidia.yaml; force with EMBED_GPU=0/1
EMBED_MODEL=google/siglip-so400m-patch14-384
EMBED_DIM=1152
EMBED_PORT=8097
