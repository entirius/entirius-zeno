# syntax=docker/dockerfile:1
FROM python:3.12-slim

ARG service=entirius-service-volkanos
ARG branch=master

# Venv outside the project dir — dev mode bind-mounts repos/ over /entirius/services
# and must not hide the installed environment.
ENV SERVICE_DIR=/entirius/services/${service} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

RUN git clone -b ${branch} --depth 1 https://github.com/entirius/${service}.git ${SERVICE_DIR}

WORKDIR ${SERVICE_DIR}

RUN uv sync --frozen

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
