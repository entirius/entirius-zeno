# syntax=docker/dockerfile:1
FROM python:3.12-slim

ARG service=entirius-service-volkanos
ARG branch=master

# Standard layout: venv lives in the project dir (.venv). In dev mode a named
# volume shadows it, so the host clone's own venv is never touched.
ENV SERVICE_DIR=/entirius/services/${service} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/entirius/services/${service}/.venv/bin:${PATH}"

# libmagic1: python-magic (pim file uploads); libgl1 + libglib2.0-0: opencv (pim video metadata)
RUN apt-get update && apt-get install -y --no-install-recommends git libmagic1 libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir uv

# Cache-bust: `ref` carries the remote branch SHA (resolved by the Makefile via
# git ls-remote) — an ADD of the GitHub API ref proved unreliable (silent cache reuse).
ARG ref=unknown
RUN echo "building ${service}@${branch} (${ref})" \
    && git clone -b ${branch} --depth 1 https://github.com/entirius/${service}.git ${SERVICE_DIR}

# Zeno owns the per-environment config of the service under test
COPY docker/settings_local.py ${SERVICE_DIR}/main/settings_local.py

WORKDIR ${SERVICE_DIR}

RUN uv sync --frozen

CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
