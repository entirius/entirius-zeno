# syntax=docker/dockerfile:1
# Marketing site entirius.com (Next.js) — private GitLab repo, bind-mounted from
# repos/www/ (make www) and served by `next dev` with hot reload.
FROM node:22-slim

RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /entirius/www

COPY docker/entrypoint-www.sh /usr/local/bin/entrypoint-www.sh
RUN chmod +x /usr/local/bin/entrypoint-www.sh

EXPOSE 3000
ENTRYPOINT ["entrypoint-www.sh"]
CMD ["npm", "run", "dev", "--", "--hostname", "0.0.0.0", "--port", "3000"]
